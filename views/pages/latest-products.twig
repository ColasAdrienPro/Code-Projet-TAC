{% extends "../layout/base.twig" %}

{% block main %}
	<main class="min-h-[calc(100vh-4rem)] bg-[#f7f8fb] px-4 py-8 text-[#0b1c30] sm:px-6 lg:px-8">
		<section class="mx-auto w-full max-w-6xl">
			{% if error %}
				<div class="mb-6 rounded-lg border border-[#f2c2c2] bg-[#fff2f2] px-4 py-3 text-sm font-semibold text-[#9a1c1c]">
					{{ error }}
				</div>
			{% endif %}

			<div class="mb-6">
				<a href="/dashboard" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#becabc] bg-white px-4 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/40">Retour au dashboard</a>
			</div>

			<div class="border-b border-[#d8ded6] pb-6">
				<p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#00652c]">Catalogue</p>
				<div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<h1 class="text-3xl font-bold leading-tight text-[#0b1c30] sm:text-4xl">Derniers produits</h1>
						<p class="mt-3 max-w-2xl text-base leading-7 text-[#3f493f]">Les 20 derniers produits ajoutes, avec recherche et filtre par categorie.</p>
					</div>
					{% if user %}
						<a href="/products/new" class="inline-flex h-11 items-center justify-center rounded-lg bg-[#00652c] px-4 text-sm font-semibold text-white transition hover:bg-[#005323]">Ajouter</a>
					{% endif %}
				</div>
			</div>

			<form action="/products/latest" method="get" class="mt-6 grid gap-3 rounded-lg border border-[#d8ded6] bg-white p-4 shadow-[0_4px_18px_rgba(15,42,28,0.05)] md:grid-cols-[1fr_1fr_auto]">
				<div>
					<label for="category" class="text-sm font-semibold text-[#3f493f]">Categorie</label>
					<select id="category" name="category" class="mt-2 h-11 w-full rounded-lg border border-[#becabc] bg-white px-3 text-sm font-semibold text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35">
						<option value="">Toutes les categories</option>
						{% for category in categories %}
							<option value="{{ category.id }}" {% if filters.categoryId == category.id %}selected{% endif %}>{{ category.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div>
					<label for="search" class="text-sm font-semibold text-[#3f493f]">Recherche precise</label>
					<input id="search" name="search" type="search" value="{{ filters.search }}" placeholder="Nom, description, categorie..." class="mt-2 h-11 w-full rounded-lg border border-[#becabc] bg-white px-3 text-sm text-[#0b1c30] outline-none transition placeholder:text-[#7b8579] focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35">
				</div>
				<div class="flex flex-wrap items-end gap-2">
					<button type="submit" class="h-11 rounded-lg bg-[#00652c] px-4 text-sm font-semibold text-white transition hover:bg-[#005323]">Filtrer</button>
					{% if filters.hasFilters %}
						<a href="/products/latest" class="inline-flex h-11 items-center rounded-lg border border-[#becabc] px-4 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Reinitialiser</a>
					{% endif %}
				</div>
			</form>

			<div class="mt-5 flex flex-wrap items-center justify-between gap-3">
				<p class="text-sm font-semibold text-[#5a6558]">{{ products|length }} sur {{ filters.productCount }} produits affiches</p>
				<p class="text-sm text-[#5a6558]">Limite: {{ filters.productLimit }} derniers produits</p>
			</div>

			{% if products|length %}
				<div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{% for product in products %}
						<article class="overflow-hidden rounded-lg border border-[#d8ded6] bg-white shadow-[0_4px_18px_rgba(15,42,28,0.05)]">
							<a href="/products/{{ product.id }}" class="block transition hover:bg-[#fbfdfb]">
								<div class="aspect-[16/9] bg-[#eef3ed]">
									<img src="{{ product.image_url }}" alt="{{ product.title }}" class="h-full w-full object-cover">
								</div>
							</a>
							<div class="p-5">
								<a href="/products/{{ product.id }}" class="block">
									<div class="flex flex-wrap items-center gap-2">
										<span class="rounded-full bg-[#e7f8ec] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#00652c]">{{ product.category.name }}</span>
										{% if product.averageNote %}
											<span class="text-sm font-semibold text-[#3f493f]">{{ product.averageNote }}/5</span>
										{% else %}
											<span class="text-sm font-semibold text-[#7b8579]">Aucun avis</span>
										{% endif %}
									</div>
									<h2 class="mt-3 text-lg font-bold text-[#0b1c30] transition hover:text-[#00652c]">{{ product.title }}</h2>
									<div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-[#3f493f]">
										<span>{{ product._count.opinions }} avis</span>
										<span>Voir le detail</span>
									</div>
								</a>
								<a href="/products/{{ product.id }}" class="mt-4 inline-flex h-10 items-center justify-center rounded-lg border border-[#becabc] px-3 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Voir le detail</a>
								{% if user and (product.user_id == user.id or user.role == 'admin' or user.role == 'modo') %}
									<div class="mt-4 flex flex-wrap gap-2 border-t border-[#edf0ec] pt-4">
										{% if product.user_id == user.id %}
											<a href="/products/{{ product.id }}/edit" class="rounded-lg border border-[#becabc] px-3 py-2 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Modifier</a>
										{% endif %}
										<form action="/products/{{ product.id }}/delete" method="post" data-confirm-message="Supprimer ce produit ?">
											<button type="submit" class="rounded-lg border border-[#f2c2c2] px-3 py-2 text-sm font-semibold text-[#9a1c1c] transition hover:bg-[#fff2f2]">Supprimer</button>
										</form>
									</div>
								{% endif %}
							</div>
						</article>
					{% endfor %}
				</div>
			{% else %}
				<div class="mt-5 rounded-lg border border-dashed border-[#becabc] bg-white p-8 text-center">
					<p class="text-base font-semibold text-[#0b1c30]">Aucun produit trouve.</p>
					<p class="mt-2 text-sm text-[#5a6558]">Essayez une autre categorie ou une recherche plus large.</p>
				</div>
			{% endif %}
		</section>
	</main>
{% endblock %}
