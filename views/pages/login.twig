{% extends "../layout/base.twig" %}

{% block main %}
	<main class="min-h-screen bg-[#f8f9ff] px-4 py-10 text-[#0b1c30] sm:px-6 lg:px-8">
		<section class="mx-auto grid w-full max-w-6xl overflow-hidden rounded-3xl border border-[#becabc] bg-white shadow-[0_4px_20px_rgba(21,128,61,0.08)] lg:grid-cols-[0.95fr_1.05fr]">
			<div class="relative hidden bg-[#00652c] p-10 text-white lg:flex lg:flex-col lg:justify-between">
				<div class="absolute inset-x-0 top-0 h-36 bg-[#15803d]/70"></div>
				<div class="absolute bottom-0 right-0 h-56 w-56 translate-x-14 translate-y-14 rotate-12 rounded-3xl bg-[#fea619]/20"></div>
				<div class="relative">
					<p class="mb-4 inline-flex rounded-full bg-white/15 px-4 py-2 text-sm font-semibold text-[#d3ffd5]">TonAvisCompte</p>
					<h1 class="max-w-sm text-4xl font-bold leading-tight">Retrouvez vos avis et votre activite.</h1>
					<p class="mt-5 max-w-md text-base leading-7 text-[#eaf1ff]">
						Connectez-vous pour acceder a votre tableau de bord et continuer a gerer votre profil.
					</p>
				</div>
				<div class="relative grid gap-4">
					<div class="rounded-2xl border border-white/20 bg-white/10 p-5 backdrop-blur">
						<p class="text-sm font-medium text-[#d3ffd5]">Espace membre</p>
						<p class="mt-2 text-2xl font-bold">Dashboard securise</p>
					</div>
					<div class="flex items-center gap-3 text-sm font-semibold text-[#ffddb8]">
						<span class="h-2.5 w-2.5 rounded-full bg-[#fea619]"></span>
						Vos informations restent accessibles uniquement apres connexion
					</div>
				</div>
			</div>

			<div class="bg-[#ffffff] px-5 py-8 sm:px-10 lg:px-12 lg:py-14">
				<div class="mx-auto max-w-xl">
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#00652c]">Connexion</p>
					<h2 class="mt-3 text-3xl font-bold leading-tight text-[#0b1c30] sm:text-4xl">Se connecter</h2>
					<p class="mt-3 text-base leading-7 text-[#3f493f]">Entrez vos identifiants pour acceder a votre tableau de bord.</p>

					{% if error %}
						<p class="mt-6 rounded-xl border border-[#ffb3ad] bg-[#ffdad6] px-4 py-3 text-sm font-medium text-[#93000a]">{{ error }}</p>
					{% endif %}

					<form action="/login" method="post" class="mt-8 grid gap-5">
						<div class="grid gap-2">
							<label for="email" class="text-sm font-semibold text-[#3f493f]">Email</label>
							<input
								type="email"
								id="email"
								name="email"
								value="{{ values.email }}"
								required
								class="h-12 rounded-lg border border-[#becabc] bg-white px-4 text-base text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/40"
							>
						</div>

						<div class="grid gap-2">
							<label for="password" class="text-sm font-semibold text-[#3f493f]">Mot de passe</label>
							<input
								type="password"
								id="password"
								name="password"
								required
								class="h-12 rounded-lg border border-[#becabc] bg-white px-4 text-base text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/40"
							>
						</div>

						<button type="submit" class="mt-2 h-12 rounded-lg bg-[#00652c] px-5 text-base font-semibold text-white shadow-[0_10px_30px_rgba(21,128,61,0.18)] transition hover:bg-[#005323] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/50 active:scale-[0.99]">Se connecter</button>
					</form>

					<p class="mt-6 text-center text-sm text-[#3f493f]">
						Vous n'avez pas encore de compte ?
						<a href="/register" class="font-semibold text-[#00652c] transition hover:text-[#005323]">S'inscrire</a>
					</p>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
