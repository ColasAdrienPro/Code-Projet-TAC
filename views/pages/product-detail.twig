{% extends "../layout/base.twig" %}

{% block main %}
	<main class="min-h-[calc(100vh-4rem)] bg-[#f7f8fb] px-4 py-8 text-[#0b1c30] sm:px-6 lg:px-8">
		<section class="mx-auto w-full max-w-6xl">
			<div class="mb-6">
				<a href="/dashboard" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#becabc] bg-white px-4 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/40">Retour</a>
			</div>

			<section class="overflow-hidden rounded-lg border border-[#d8ded6] bg-white shadow-[0_4px_18px_rgba(15,42,28,0.05)]">
				<div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
					<div class="bg-[#eef3ed]">
						<img src="{{ product.image_url }}" alt="{{ product.title }}" class="h-full min-h-72 w-full object-cover">
					</div>

					<div class="p-5 sm:p-8">
						<div class="flex flex-wrap items-center gap-2">
							<span class="rounded-full bg-[#e7f8ec] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#00652c]">{{ product.category.name }}</span>
							{% if product.status == 'pending' %}
								<span class="rounded-full bg-[#fff1d6] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#8a4a00]">En attente de validation</span>
							{% endif %}
							{% if product.averageNote %}
								<span class="rounded-full bg-[#fff1d6] px-3 py-1 text-sm font-bold text-[#8a4a00]">{{ product.averageNote }}/5</span>
							{% else %}
								<span class="rounded-full bg-[#edf0ec] px-3 py-1 text-sm font-bold text-[#5a6558]">Aucun avis</span>
							{% endif %}
						</div>

						<h1 class="mt-4 text-3xl font-bold leading-tight text-[#0b1c30] sm:text-4xl">{{ product.title }}</h1>
						<p class="mt-4 text-base leading-7 text-[#3f493f]">{{ product.description }}</p>

						<div class="mt-6 grid gap-3 border-t border-[#edf0ec] pt-5 sm:grid-cols-3">
							<div class="rounded-lg bg-[#f1f6f0] p-4">
								<p class="text-sm font-semibold text-[#5a6558]">Avis</p>
								<p class="mt-1 text-2xl font-bold text-[#00652c]">{{ product._count.opinions }}</p>
							</div>
							<div class="rounded-lg bg-[#f1f6f0] p-4">
								<p class="text-sm font-semibold text-[#5a6558]">Sortie</p>
								<p class="mt-1 text-base font-bold text-[#0b1c30]">{{ product.releaseDateLabel }}</p>
							</div>
							<div class="rounded-lg bg-[#f1f6f0] p-4">
								<p class="text-sm font-semibold text-[#5a6558]">Ajoute par</p>
								<p class="mt-1 truncate text-base font-bold text-[#0b1c30]">{{ product.user.username }}</p>
							</div>
						</div>

						{% if user and (product.user_id == user.id or user.role == 'admin' or user.role == 'modo') %}
							<div class="mt-6 flex flex-wrap gap-2">
								{% if product.user_id == user.id %}
									<a href="/products/{{ product.id }}/edit" class="rounded-lg border border-[#becabc] px-4 py-2 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Modifier</a>
								{% endif %}
								<form action="/products/{{ product.id }}/delete" method="post" data-confirm-message="Supprimer ce produit ?">
									<button type="submit" class="rounded-lg border border-[#f2c2c2] px-4 py-2 text-sm font-semibold text-[#9a1c1c] transition hover:bg-[#fff2f2]">Supprimer</button>
								</form>
							</div>
						{% endif %}
						{% if product.status == 'pending' and user and (user.role == 'admin' or user.role == 'modo') %}
							<div class="mt-6 flex flex-wrap gap-2">
								<form action="/products/{{ product.id }}/approve" method="post" data-confirm-message="Etes-vous sur de vouloir rendre ce produit public ?">
									<button type="submit" class="rounded-lg bg-[#00652c] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#005323]">Rendre public</button>
								</form>
								<a href="/products/validation" class="rounded-lg border border-[#becabc] px-4 py-2 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Demandes</a>
							</div>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="mt-8">
				<div class="flex items-end justify-between gap-4 border-b border-[#d8ded6] pb-3">
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#00652c]">Avis</p>
						<h2 class="mt-1 text-2xl font-bold text-[#0b1c30]">Avis lies au produit</h2>
					</div>
					<div class="flex flex-wrap items-center justify-end gap-3">
						<p class="text-sm font-semibold text-[#5a6558]">{{ product.opinions|length }} affiches</p>
						{% if user and product.status == 'public' %}
							<a href="/products/{{ product.id }}/opinions/new" class="rounded-lg bg-[#00652c] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#005323]">Ajouter un avis</a>
						{% endif %}
					</div>
				</div>

				{% if product.opinions|length %}
					<div class="mt-5 grid gap-4">
						{% for opinion in product.opinions %}
							<article id="opinion-{{ opinion.id }}" class="rounded-lg border border-[#d8ded6] bg-white p-5 shadow-[0_4px_18px_rgba(15,42,28,0.05)]">
								<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
									<div>
										<div class="flex flex-wrap items-center gap-2">
											<p class="text-sm font-semibold text-[#00652c]">Par {{ opinion.user.username }}</p>
											<span class="rounded-full px-2.5 py-1 text-xs font-bold {% if opinion.user.is_verified %}bg-[#d3ffd5] text-[#00652c]{% else %}bg-[#fff1d6] text-[#8a4a00]{% endif %}">
												{% if opinion.user.is_verified %}Compte verifie{% else %}Compte non verifie{% endif %}
											</span>
										</div>
										<h3 class="mt-1 text-xl font-bold text-[#0b1c30]">{{ opinion.title }}</h3>
									</div>
									<span class="inline-flex shrink-0 rounded-full bg-[#e7f8ec] px-3 py-1 text-sm font-bold text-[#00652c]">{{ opinion.note }}/5</span>
								</div>
								<p class="mt-3 text-sm leading-6 text-[#5a6558]">{{ opinion.text }}</p>
								<div class="mt-4 flex flex-wrap items-center gap-3">
									<p class="text-xs font-semibold uppercase tracking-[0.08em] text-[#7b8579]">{{ opinion._count.comments }} commentaires - <span data-like-count>{{ opinion._count.likedBy }}</span> likes</p>
									{% if user %}
										<form action="/opinions/{{ opinion.id }}/like" method="post" data-like-form data-liked="{{ opinion.isLikedByCurrentUser ? 'true' : 'false' }}">
											<button type="submit" data-like-button class="inline-flex h-9 items-center justify-center rounded-lg border px-3 text-sm font-semibold transition {% if opinion.isLikedByCurrentUser %}border-[#00652c] bg-[#e7f8ec] text-[#00652c] hover:bg-[#d3ffd5]{% else %}border-[#becabc] bg-white text-[#00652c] hover:border-[#00652c] hover:bg-[#ecfdf0]{% endif %}">
												{% if opinion.isLikedByCurrentUser %}Je n'aime plus{% else %}J'aime{% endif %}
											</button>
										</form>
									{% endif %}
								</div>
								{% if user and (opinion.user_id == user.id or user.role == 'admin' or user.role == 'modo') %}
									<div class="mt-4 flex flex-wrap gap-2 border-t border-[#edf0ec] pt-4">
										{% if opinion.user_id == user.id %}
											<a href="/opinions/{{ opinion.id }}/edit" class="rounded-lg border border-[#becabc] px-3 py-2 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Modifier</a>
										{% endif %}
										<form action="/opinions/{{ opinion.id }}/delete" method="post" data-confirm-message="Supprimer cet avis ?">
											<button type="submit" class="rounded-lg border border-[#f2c2c2] px-3 py-2 text-sm font-semibold text-[#9a1c1c] transition hover:bg-[#fff2f2]">Supprimer</button>
										</form>
									</div>
								{% endif %}

								<div class="mt-5 border-t border-[#edf0ec] pt-5">
									<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
										<h4 class="text-base font-bold text-[#0b1c30]">Commentaires</h4>
										<span class="text-sm font-semibold text-[#5a6558]">{{ opinion.comments|length }} affiches</span>
									</div>

									{% if commentError %}
										<p class="mt-3 rounded-lg border border-[#f2c2c2] bg-[#fff2f2] px-3 py-2 text-sm font-semibold text-[#9a1c1c]">{{ commentError }}</p>
									{% endif %}

									<form action="/opinions/{{ opinion.id }}/comments" method="post" class="mt-4 grid gap-3 rounded-lg border border-[#d8ded6] bg-[#f7f8fb] p-4">
										<div class="grid gap-3 sm:grid-cols-[0.9fr_1.4fr]">
											<label class="block">
												<span class="text-sm font-semibold text-[#3f493f]">Titre</span>
												<input name="title" type="text" maxlength="255" required class="mt-2 h-11 w-full rounded-lg border border-[#becabc] bg-white px-3 text-sm text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35">
											</label>
											<label class="block">
												<span class="text-sm font-semibold text-[#3f493f]">Commentaire</span>
												<textarea name="text" rows="3" required class="mt-2 w-full rounded-lg border border-[#becabc] bg-white px-3 py-2 text-sm text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35"></textarea>
											</label>
										</div>
										<div class="flex flex-wrap items-center justify-between gap-3">
											<p class="text-xs font-semibold uppercase tracking-[0.08em] text-[#7b8579]">{% if user %}Publie en tant que {{ user.username }}{% else %}Publie en anonyme{% endif %}</p>
											<button type="submit" class="rounded-lg bg-[#00652c] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#005323]">Publier</button>
										</div>
									</form>

									{% if opinion.comments|length %}
										<div class="mt-4 grid gap-3">
											{% for comment in opinion.comments %}
												<div class="rounded-lg border border-[#edf0ec] bg-white p-4">
													<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
														<div>
															<p class="text-sm font-semibold text-[#00652c]">Par {{ comment.user ? comment.user.username : 'Anonyme' }}</p>
															<h5 class="mt-1 font-bold text-[#0b1c30]">{{ comment.title }}</h5>
														</div>
														<div class="flex shrink-0 flex-wrap items-center gap-2">
															<span class="text-xs font-semibold uppercase tracking-[0.08em] text-[#7b8579]"><span data-like-count>{{ comment._count.likedBy }}</span> likes</span>
															{% if user %}
																<form action="/comments/{{ comment.id }}/like" method="post" data-like-form data-liked="{{ comment.isLikedByCurrentUser ? 'true' : 'false' }}">
																	<button type="submit" data-like-button class="inline-flex h-8 items-center justify-center rounded-lg border px-2.5 text-xs font-semibold transition {% if comment.isLikedByCurrentUser %}border-[#00652c] bg-[#e7f8ec] text-[#00652c] hover:bg-[#d3ffd5]{% else %}border-[#becabc] bg-white text-[#00652c] hover:border-[#00652c] hover:bg-[#ecfdf0]{% endif %}">
																		{% if comment.isLikedByCurrentUser %}Retirer{% else %}J'aime{% endif %}
																	</button>
																</form>
															{% endif %}
														</div>
													</div>
													<p class="mt-2 text-sm leading-6 text-[#5a6558]">{{ comment.text }}</p>
													{% if user and ((comment.user_id and comment.user_id == user.id) or user.role == 'admin' or user.role == 'modo') %}
														<div class="mt-3 flex flex-wrap gap-2 border-t border-[#edf0ec] pt-3">
															{% if comment.user_id and comment.user_id == user.id %}
																<a href="/comments/{{ comment.id }}/edit" class="rounded-lg border border-[#becabc] px-3 py-2 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Modifier</a>
															{% endif %}
															<form action="/comments/{{ comment.id }}/delete" method="post" data-confirm-message="Supprimer ce commentaire ?">
																<button type="submit" class="rounded-lg border border-[#f2c2c2] px-3 py-2 text-sm font-semibold text-[#9a1c1c] transition hover:bg-[#fff2f2]">Supprimer</button>
															</form>
														</div>
													{% endif %}
												</div>
											{% endfor %}
										</div>
									{% else %}
										<p class="mt-4 rounded-lg border border-dashed border-[#becabc] bg-white p-4 text-sm font-semibold text-[#5a6558]">Aucun commentaire pour cet avis.</p>
									{% endif %}
								</div>
							</article>
						{% endfor %}
					</div>
				{% else %}
					<div class="mt-5 rounded-lg border border-dashed border-[#becabc] bg-white p-8 text-center">
						<p class="text-base font-semibold text-[#0b1c30]">Aucun avis pour ce produit.</p>
						<p class="mt-2 text-sm text-[#5a6558]">Les avis apparaitront ici quand ils seront publies.</p>
						{% if user and product.status == 'public' %}
							<a href="/products/{{ product.id }}/opinions/new" class="mt-5 inline-flex h-11 items-center justify-center rounded-lg bg-[#00652c] px-4 text-sm font-semibold text-white transition hover:bg-[#005323]">Publier le premier avis</a>
						{% endif %}
					</div>
				{% endif %}
			</section>
		</section>
	</main>
{% endblock %}
