{% extends "../layout/base.twig" %}

{% block main %}
	<main class="min-h-[calc(100vh-4rem)] bg-[#f7f8fb] px-4 py-8 text-[#0b1c30] sm:px-6 lg:px-8">
		<section class="mx-auto w-full max-w-6xl">
			<div class="mb-8 flex flex-col gap-4 border-b border-[#d8ded6] pb-6 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#00652c]">Produit</p>
					<h1 class="mt-2 text-3xl font-bold leading-tight text-[#0b1c30] sm:text-4xl">{{ title }}</h1>
				</div>
				<a href="/dashboard" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#becabc] bg-white px-4 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/40">Retour</a>
			</div>

			{% if error %}
				<div class="mb-6 rounded-lg border border-[#f2c2c2] bg-[#fff2f2] px-4 py-3 text-sm font-semibold text-[#9a1c1c] shadow-[0_8px_24px_rgba(154,28,28,0.06)]">
					{{ error }}
				</div>
			{% endif %}

			<form action="{{ action }}" method="post" class="grid gap-6 lg:grid-cols-[1fr_360px]">
				<div class="rounded-lg border border-[#d8ded6] bg-white p-5 shadow-[0_4px_18px_rgba(15,42,28,0.05)] sm:p-6">
					<div class="grid gap-5 sm:grid-cols-2">
						<div class="sm:col-span-2">
							<label for="title" class="text-sm font-semibold text-[#3f493f]">Titre</label>
							<input id="title" name="title" type="text" value="{{ values.title }}" class="mt-2 h-12 w-full rounded-lg border border-[#becabc] bg-white px-4 text-base text-[#0b1c30] outline-none transition placeholder:text-[#8b9489] focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35" placeholder="Nom du produit" required>
						</div>

						<div>
							<label for="category_id" class="text-sm font-semibold text-[#3f493f]">Categorie</label>
							<select id="category_id" name="category_id" class="mt-2 h-12 w-full rounded-lg border border-[#becabc] bg-white px-4 text-base text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35" required>
								<option value="">Choisir une categorie</option>
								{% for category in categories %}
									<option value="{{ category.id }}" {% if values.category_id == category.id %}selected{% endif %}>{{ category.name }}</option>
								{% endfor %}
							</select>
						</div>

						<div>
							<label for="release_date" class="text-sm font-semibold text-[#3f493f]">Date de sortie</label>
							<input id="release_date" name="release_date" type="date" value="{{ values.release_date }}" class="mt-2 h-12 w-full rounded-lg border border-[#becabc] bg-white px-4 text-base text-[#0b1c30] outline-none transition focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35" required>
						</div>

						<div class="sm:col-span-2">
							<label for="image_url" class="text-sm font-semibold text-[#3f493f]">URL de l'image</label>
							<input id="image_url" name="image_url" type="url" value="{{ values.image_url }}" class="mt-2 h-12 w-full rounded-lg border border-[#becabc] bg-white px-4 text-base text-[#0b1c30] outline-none transition placeholder:text-[#8b9489] focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35" placeholder="https://exemple.com/image.jpg" required>
						</div>

						<div class="sm:col-span-2">
							<label for="description" class="text-sm font-semibold text-[#3f493f]">Description</label>
							<textarea id="description" name="description" rows="8" class="mt-2 min-h-44 w-full resize-y rounded-lg border border-[#becabc] bg-white px-4 py-3 text-base leading-7 text-[#0b1c30] outline-none transition placeholder:text-[#8b9489] focus:border-[#00652c] focus:ring-4 focus:ring-[#95f8a7]/35" placeholder="Description du produit" required>{{ values.description }}</textarea>
						</div>
					</div>

					<div class="mt-6 flex flex-col-reverse gap-3 border-t border-[#edf0ec] pt-5 sm:flex-row sm:justify-end">
						<a href="/dashboard" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#becabc] bg-white px-5 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/40">Annuler</a>
						<button type="submit" class="inline-flex h-11 items-center justify-center rounded-lg bg-[#00652c] px-5 text-sm font-semibold text-white shadow-[0_10px_28px_rgba(0,101,44,0.18)] transition hover:bg-[#005323] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/50 active:scale-[0.99]">{{ submitLabel }}</button>
					</div>
				</div>

				<aside class="rounded-lg border border-[#d8ded6] bg-white p-5 shadow-[0_4px_18px_rgba(15,42,28,0.05)] lg:sticky lg:top-24 lg:self-start">
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#00652c]">Apercu</p>
					<div class="mt-4 overflow-hidden rounded-lg border border-[#d8ded6] bg-[#eef3ed]">
						<div class="aspect-[16/10]">
							{% if values.image_url %}
								<img src="{{ values.image_url }}" alt="{{ values.title|default('Produit') }}" class="h-full w-full object-cover">
							{% else %}
								<div class="flex h-full w-full items-center justify-center px-6 text-center text-sm font-semibold text-[#5a6558]">Image du produit</div>
							{% endif %}
						</div>
					</div>
					<div class="mt-5">
						{% if values.category_id %}
							{% for category in categories %}
								{% if values.category_id == category.id %}
									<span class="inline-flex rounded-full bg-[#e7f8ec] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#00652c]">{{ category.name }}</span>
								{% endif %}
							{% endfor %}
						{% else %}
							<span class="inline-flex rounded-full bg-[#edf0ec] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#5a6558]">Categorie</span>
						{% endif %}
						<h2 class="mt-3 break-words text-xl font-bold leading-snug text-[#0b1c30]">{{ values.title|default('Nom du produit') }}</h2>
						<p class="mt-2 break-words text-sm leading-6 text-[#5a6558]">
							{% if values.description %}
								{{ values.description }}
							{% else %}
								Description du produit
							{% endif %}
						</p>
					</div>
				</aside>
			</form>
		</section>
	</main>
{% endblock %}
