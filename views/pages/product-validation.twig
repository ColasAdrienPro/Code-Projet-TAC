{% extends "../layout/base.twig" %}

{% block main %}
	<main class="min-h-[calc(100vh-4rem)] bg-[#f7f8fb] px-4 py-8 text-[#0b1c30] sm:px-6 lg:px-8">
		<section class="mx-auto w-full max-w-6xl">
			{% if error %}
				<div class="mb-6 rounded-lg border border-[#f2c2c2] bg-[#fff2f2] px-4 py-3 text-sm font-semibold text-[#9a1c1c]">
					{{ error }}
				</div>
			{% endif %}

			{% if success %}
				<div class="mb-6 rounded-lg border border-[#8bd99a] bg-[#ddffe3] px-4 py-3 text-sm font-semibold text-[#005323]">
					{{ success }}
				</div>
			{% endif %}

			<div class="mb-6">
				<a href="/dashboard" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#becabc] bg-white px-4 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0] focus:outline-none focus:ring-4 focus:ring-[#95f8a7]/40">Retour au dashboard</a>
			</div>

			<div class="border-b border-[#d8ded6] pb-6">
				<p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#00652c]">Moderation</p>
				<div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<h1 class="text-3xl font-bold leading-tight text-[#0b1c30] sm:text-4xl">Demandes de validation</h1>
						<p class="mt-3 max-w-2xl text-base leading-7 text-[#3f493f]">Verifiez les informations avant de rendre le produit visible publiquement.</p>
					</div>
					<p class="inline-flex rounded-full bg-[#fff1d6] px-3 py-1 text-sm font-bold text-[#8a4a00]">{{ products|length }} en attente</p>
				</div>
			</div>

			{% if products|length %}
				<div class="mt-6 grid gap-4">
					{% for product in products %}
						<article class="overflow-hidden rounded-lg border border-[#d8ded6] bg-white shadow-[0_4px_18px_rgba(15,42,28,0.05)]">
							<div class="grid gap-0 lg:grid-cols-[280px_1fr]">
								<a href="/products/{{ product.id }}" class="block bg-[#eef3ed]">
									<img src="{{ product.image_url }}" alt="{{ product.title }}" class="h-full min-h-56 w-full object-cover">
								</a>
								<div class="p-5">
									<div class="flex flex-wrap items-center gap-2">
										<span class="rounded-full bg-[#e7f8ec] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#00652c]">{{ product.category.name }}</span>
										<span class="rounded-full bg-[#fff1d6] px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-[#8a4a00]">En attente</span>
									</div>

									<h2 class="mt-3 text-xl font-bold text-[#0b1c30]">{{ product.title }}</h2>
									<p class="mt-2 text-sm leading-6 text-[#5a6558]">{{ product.descriptionPreview }}</p>

									<div class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
										<div class="rounded-lg bg-[#f1f6f0] p-3">
											<p class="font-semibold text-[#5a6558]">Ajoute par</p>
											<p class="mt-1 font-bold text-[#0b1c30]">{{ product.user.username }}</p>
										</div>
										<div class="rounded-lg bg-[#f1f6f0] p-3">
											<p class="font-semibold text-[#5a6558]">Sortie</p>
											<p class="mt-1 font-bold text-[#0b1c30]">{{ product.releaseDateLabel }}</p>
										</div>
										<div class="rounded-lg bg-[#f1f6f0] p-3">
											<p class="font-semibold text-[#5a6558]">Cree le</p>
											<p class="mt-1 font-bold text-[#0b1c30]">{{ product.createdAtLabel }}</p>
										</div>
									</div>

									<div class="mt-5 flex flex-wrap items-center gap-2 border-t border-[#edf0ec] pt-4">
										<a href="/products/{{ product.id }}" class="rounded-lg border border-[#becabc] px-4 py-2 text-sm font-semibold text-[#00652c] transition hover:border-[#00652c] hover:bg-[#ecfdf0]">Voir la fiche</a>
										<form action="/products/{{ product.id }}/approve" method="post" data-confirm-message="Etes-vous sur de vouloir rendre ce produit public ?">
											<button type="submit" class="rounded-lg bg-[#00652c] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#005323]">Rendre public</button>
										</form>
										<form action="/products/{{ product.id }}/moderation-delete" method="post" data-confirm-message="Etes-vous sur de vouloir supprimer ce produit ?">
											<button type="submit" class="rounded-lg border border-[#f2c2c2] px-4 py-2 text-sm font-semibold text-[#9a1c1c] transition hover:bg-[#fff2f2]">Supprimer</button>
										</form>
									</div>
								</div>
							</div>
						</article>
					{% endfor %}
				</div>
			{% else %}
				<div class="mt-6 rounded-lg border border-dashed border-[#becabc] bg-white p-8 text-center">
					<p class="text-base font-semibold text-[#0b1c30]">Aucune demande en attente.</p>
					<p class="mt-2 text-sm text-[#5a6558]">Les prochains produits crees apparaitront ici.</p>
				</div>
			{% endif %}
		</section>
	</main>
{% endblock %}
